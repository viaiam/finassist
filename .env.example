# 所有配置使用 FINASSIST_ 前缀；本地复制为 .env 后填写真实值。
FINASSIST_LLM_MODEL=your-model-name
FINASSIST_LLM_BASE_URL=https://your-model-provider.example/v1
FINASSIST_LLM_API_KEY=replace-with-your-key
FINASSIST_BUSINESS_API_BASE_URL=http://127.0.0.1:18081
FINASSIST_DATABASE_URL=mysql+aiomysql://root:change-me@127.0.0.1:3306/finassist?charset=utf8mb4
FINASSIST_APP_HOST=127.0.0.1
FINASSIST_APP_PORT=18082
